rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isModerator() {
      return isSignedIn() && request.auth.token.moderator == true;
    }

    // Public profilde KVKK özel nitelikli veri veya telefon/tam konum bulunamaz.
    function hasNoSensitiveFieldsInPublicDoc(data) {
      return !('phoneNumber' in data)
        && !('bloodType' in data)
        && !('weightKg' in data)
        && !('birthDate' in data)
        && !('fullName' in data)
        && !('exactLocation' in data)
        && !('lastDonationAt' in data)
        && !('nextEligibleAt' in data)
        && !('donationHistory' in data)
        && !('healthSurvey' in data);
    }

    // KVKK Madde 6: Özel nitelikli sağlık verileri (bağış geçmişi, sağlık anketi)
    // açık rıza (`private_data/consents.healthDataConsent == true`) olmadan yazılamaz.
    function hasHealthDataConsent(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/private_data/consents)
        && get(/databases/$(database)/documents/users/$(userId)/private_data/consents).data.healthDataConsent == true;
    }

    // İstemci yalnızca manuel bağış kaydı (`source == 'manual'`) oluşturabilir;
    // talep akışı kayıtları (`source == 'request'`) Cloud Function (Admin SDK) tarafından yazılır.
    function isValidManualDonationRecord(data) {
      return data.source == 'manual'
        && data.place is string
        && data.place.size() > 0
        && data.place.size() <= 160
        && data.productType in ['whole_blood', 'erythrocyte', 'platelet', 'plasma']
        && data.donatedAt is string
        && data.createdAt is string;
    }

    function isValidHealthSurveyRecord(data) {
      return data.outcome in ['looks_eligible', 'unsure', 'looks_ineligible']
        && data.answers is map
        && data.questionnaireVersion is string
        && data.completedAt is string;
    }

    // Public kan talebinde hasta yakını telefon numarası veya tam hasta adı bulunamaz.
    function hasNoPrivateContactInPublicRequest(data) {
      return !('contactPhone' in data)
        && !('patientFullName' in data);
    }

    // Genel (Public) kullanıcı dokümanı
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && hasNoSensitiveFieldsInPublicDoc(request.resource.data);
      allow delete: if isOwner(userId);

      // KVKK Özel Nitelikli Kişisel Veriler, Açık Rıza Kaydı ve Bildirim Tercihleri
      match /private_data/{docId} {
        allow read, write: if isOwner(userId);
      }

      // KVKK Özel Nitelikli Sağlık Verisi: Bağış Geçmişi
      match /donation_history/{donationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasHealthDataConsent(userId)
          && isValidManualDonationRecord(request.resource.data);
        allow delete: if isOwner(userId)
          && resource.data.source == 'manual';
      }

      // KVKK Özel Nitelikli Sağlık Verisi: Bağışa Uygunluk Ön Kontrol Anketleri
      match /health_surveys/{surveyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasHealthDataConsent(userId)
          && isValidHealthSurveyRecord(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Kan Talepleri Koleksiyonu
    match /blood_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && hasNoPrivateContactInPublicRequest(request.resource.data);
      allow update: if isSignedIn()
        && (resource.data.requesterUid == request.auth.uid || isModerator())
        && hasNoPrivateContactInPublicRequest(request.resource.data);
      allow delete: if isSignedIn()
        && (resource.data.requesterUid == request.auth.uid || isModerator());

      // Hasta yakını gizli iletişim bilgisi: Sadece talep sahibi ve moderatör okuyabilir/yazabilir.
      match /private_contact/{docId} {
        allow read, write: if isSignedIn() && (
          get(/databases/$(database)/documents/blood_requests/$(requestId)).data.requesterUid == request.auth.uid
          || isModerator()
        );
      }

      // Bağışçı yardım teklifleri
      match /offers/{donorUid} {
        allow read: if isSignedIn() && (
          request.auth.uid == donorUid
          || get(/databases/$(database)/documents/blood_requests/$(requestId)).data.requesterUid == request.auth.uid
        );
        allow create, update: if isSignedIn() && (
          request.auth.uid == donorUid
          || get(/databases/$(database)/documents/blood_requests/$(requestId)).data.requesterUid == request.auth.uid
        );
      }

      // Karşılıklı onay sonrası açılan iletişim numaraları:
      // Yalnızca ilgili bağışçı ve talep sahibi erişebilir.
      match /mutual_contacts/{donorUid} {
        allow read: if isSignedIn() && (
          request.auth.uid == donorUid
          || get(/databases/$(database)/documents/blood_requests/$(requestId)).data.requesterUid == request.auth.uid
        );
        allow create, update: if isSignedIn()
          && get(/databases/$(database)/documents/blood_requests/$(requestId)).data.requesterUid == request.auth.uid;
      }
    }

    // Şikayet / Raporlama Koleksiyonu
    match /request_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if isModerator();
    }

    // Varsayılan olarak diğer tüm erişimleri kapat
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
