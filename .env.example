# Türkiye Kan Ağı — Örnek Ortam Değişkenleri (.env.example)
# Gerçek anahtarları koda gömmeyin. --dart-define-from-file=.env.dev veya .env.prod ile kullanın.

APP_ENV=dev
USE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=127.0.0.1

# Dev Firebase Config
FIREBASE_API_KEY=AIzaSyDummyDevKeyReplaceMe
FIREBASE_APP_ID_ANDROID=1:000000000000:android:dev000000000000
FIREBASE_APP_ID_IOS=1:000000000000:ios:dev000000000000
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_PROJECT_ID=turkiye-kan-agi-dev
FIREBASE_STORAGE_BUCKET=turkiye-kan-agi-dev.appspot.com
IOS_BUNDLE_ID=tr.org.kanagi.turkiyeKanAgi.dev
